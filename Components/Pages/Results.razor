@page "/results"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Globalization
@inject QuestionnaireState State
@inject NavigationManager Nav

<PageTitle>Rezultatai</PageTitle>

<h1 class="h4">Jūsų atsakymai</h1>
<p class="text-muted">Planų palyginimas ir rekomendacija bus pridėti vėliau.</p>

@if (State.Analysis is { } analysis)
{
    <div class="alert @(analysis.Success ? "alert-info" : "alert-warning")">
        @if (analysis.Success)
        {
            <div><strong>Įkelto failo analizė:</strong> @analysis.FileName</div>
            <div>Įrašų: @analysis.Readings, mėnesių: @analysis.Months</div>
            @if (analysis.MonthlyAverageKwh is { } average)
            {
                <div>Vidutiniškai: @Format(average) kWh/mėn.</div>
            }
            @if (analysis.NightShare is { } night)
            {
                <div>Naktinis suvartojimas: @((night * 100).ToString("0", Lt)) %</div>
            }
        }
        else
        {
            <div><strong>Failo nuskaityti nepavyko:</strong> @analysis.Error</div>
        }
    </div>
}

@foreach (var section in Sections)
{
    <h2 class="h6 mt-4">@section</h2>
    <ul class="list-group">
        @foreach (var question in Questionnaire.Questions.Where(q => q.Section == section && State.IsVisible(q)))
        {
            var answer = State.GetAnswer(question.Id);

            <li class="list-group-item">
                <div class="fw-semibold">@question.Id. @question.Text</div>
                <div>
                    @QuestionnaireState.FormatAnswer(answer)
                    @if (answer.IsAuto)
                    {
                        <span class="badge text-bg-info ms-1">automatinis</span>
                    }
                </div>
            </li>
        }
    </ul>
}

@if (State.LastSavedPath is { } path)
{
    <p class="text-muted small mt-3 mb-0">Atsakymai išsaugoti į: <code>@path</code></p>
}

<div class="d-flex flex-wrap gap-2 mt-4">
    <button type="button" class="btn btn-primary" @onclick="SaveAgain">Išsaugoti .txt dar kartą</button>
    <button type="button" class="btn btn-outline-secondary" @onclick="Restart">Pildyti iš naujo</button>
</div>

@code {
    private static readonly CultureInfo Lt = CultureInfo.GetCultureInfo("lt-LT");

    private IEnumerable<string> Sections =>
        Questionnaire.Questions.Where(State.IsVisible).Select(q => q.Section).Distinct();

    protected override async Task OnParametersSetAsync() => await State.LoadAsync();

    private static string Format(double value) => value.ToString("0.0", Lt);

    private async Task SaveAgain() => await State.SubmitAsync();

    private async Task Restart()
    {
        await State.ResetAsync();
        Nav.NavigateTo("/survey");
    }
}
