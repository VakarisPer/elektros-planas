@page "/results"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Globalization
@inject QuestionnaireState State
@inject PlanCalculator Calculator
@inject SolarAdvisor Solar
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Rezultatai · Elektros planas</PageTitle>

@if (!_loaded)
{
    <p class="muted">Kraunama…</p>
}
else if (State.AnsweredQuestions().Count == 0 && State.Analysis is not { Success: true })
{
    <div class="panel empty">
        <div class="eyebrow">Dar nėra duomenų</div>
        <h1 class="h3 mt-1">Atsakykite į kelis klausimus</h1>
        <p class="muted">Asistentas užduos tik tuos klausimus, kurie svarbūs jūsų situacijai.</p>
        <a class="btn btn-primary btn-lg" href="assistant">Pradėti su asistentu →</a>
    </div>
}
else
{
    var rec = State.Recommendation;
    var best = PlanCalculator.BestPerType(_estimates);
    var recommendedId = rec?.PlanId ?? PlanCalculator.Recommended(_estimates).Id;
    var bestFixed = best.FirstOrDefault(b => b.Type == PlanType.Fixed);
    var maxCost = best.Max(e => e.WorstCost);
    var offer = _estimates.FirstOrDefault(e => e.Id == recommendedId) ?? PlanCalculator.Recommended(_estimates);
    var reference = PlanCalculator.ReferencePlan(_estimates);
    var saved = reference is not null && reference.Id != offer.Id ? reference.YearlyCost - offer.YearlyCost : (double?)null;

    @* ── Paprasta dalis: ką rinktis ir kiek sutaupysite ── *@
    <div class="page-head">
        <div class="eyebrow">Jūsų rezultatas</div>
        <h1>@(rec is null ? "Preliminarus pasiūlymas" : "Jūsų elektros planas")</h1>
        <p>Trumpai – ką rinktis ir kiek sutaupysite. Smulki techninė informacija – puslapio apačioje.</p>
    </div>

    @if (rec is null)
    {
        <div class="notice notice-warn mb-3">
            Apklausa dar nebaigta – skaičiai preliminarūs.
            <a href="assistant">Tęsti su asistentu →</a>
        </div>
    }

    <section class="panel offer">
        <div class="offer-top">
            <div>
                <div class="eyebrow">Rekomenduojame</div>
                <div class="offer-plan">@offer.PlanName</div>
                <div class="offer-eso">su ESO planu „@offer.EsoPlan“, @(offer.Zones == 1 ? "1 laiko zona" : $"{offer.Zones} laiko zonos")</div>
            </div>
            <div class="offer-price">
                <div class="offer-big">@Eur(offer.MonthlyCost)<span> / mėn.</span></div>
                @if (saved is { } s)
                {
                    <div class="offer-save @(s >= 0 ? "pos" : "neg")">@(s >= 0 ? "Sutaupysite" : "Brangiau") ~@Eur(Math.Abs(s) / 12) per mėnesį (~@Eur(Math.Abs(s)) per metus)</div>
                }
            </div>
        </div>

        <ul class="reasons">
            @foreach (var reason in _reasons)
            {
                <li>@reason</li>
            }
        </ul>

        @if (saved is not null)
        {
            <p class="muted small mb-0">Sutaupymas – palyginti su įprastu planu (ESO „Standartinis“, 1 zona ir fiksuota kaina – @Eur(reference!.MonthlyCost) / mėn.). Visos sumos su PVM.</p>
        }

        @if (rec is not null)
        {
            <details class="fold mt-3">
                <summary>@(rec.ByAi ? "✦ Asistento paaiškinimas" : "Išsamus paaiškinimas")</summary>
                <div class="md hero-text">@Markdown.ToHtml(rec.SummaryMarkdown)</div>
            </details>
        }
    </section>

    @if (_solarReport is { } sr)
    {
        var isBattery = sr.IsBatteryMode;
        var monthMax = Math.Max(1, sr.MonthlyBillBefore.Concat(sr.MonthlyBillAfter).Max());

        <section class="solar panel">
            <div class="solar-head">
                <div>
                    <div class="eyebrow">@(sr.Mode == SolarMode.BatteryOnly ? "🔋 Kaupiklis" : isBattery ? "☀️ Jūsų saulės elektrinė + kaupiklis" : "☀️ Saulės elektrinė")</div>
                    <h2>@sr.ChosenLabel</h2>
                    <p class="muted mb-0">@sr.Verdict</p>
                </div>
                <span class="pill @(sr.WorthIt ? "pill-ok" : "pill-accent")">@(sr.WorthIt ? "Verta" : "Neverta")</span>
            </div>

            <div class="kpis">
                @if (sr.Mode != SolarMode.HasBattery && sr.Chosen.Capex > 0)
                {
                    <div class="kpi"><div class="kpi-label">Kainuotų (su APVA)</div><div class="kpi-value">@Eur(sr.Chosen.Capex)</div><div class="kpi-note">įranga ~@Eur(sr.Chosen.GrossCapex), APVA −@Eur(sr.Chosen.Subsidy)</div></div>
                    <div class="kpi"><div class="kpi-label">Atsipirktų per</div><div class="kpi-value">@(sr.Chosen.PaybackYears is { } y ? y.ToString("0.#", Lt) + " m." : "—")</div></div>
                }
                <div class="kpi"><div class="kpi-label">Sutaupytumėte per metus</div><div class="kpi-value">@Eur(sr.Chosen.Year1Savings)</div></div>
                <div class="kpi"><div class="kpi-label">Sąskaita per mėnesį</div><div class="kpi-value">@Eur(sr.MonthlyBillAfter.Sum() / 12)</div><div class="kpi-note">vietoj @Eur(sr.MonthlyBillBefore.Sum() / 12)</div></div>
            </div>

            <h3 class="solar-sub">Sąskaita per mėnesius</h3>
            <div class="months" role="img" aria-label="Mėnesio sąskaita prieš ir po">
                @for (var m = 0; m < 12; m++)
                {
                    var beforeVal = sr.MonthlyBillBefore[m];
                    var afterVal = sr.MonthlyBillAfter[m];
                    <div class="month" title="@MonthNames[m]: @Eur(afterVal) (buvo @Eur(beforeVal))">
                        <div class="bars">
                            <div class="bar bar-before" style="height:@Css(Math.Max(0, beforeVal) * 100 / monthMax)%"></div>
                            <div class="bar bar-after" style="height:@Css(Math.Max(0, afterVal) * 100 / monthMax)%"></div>
                        </div>
                        <div class="month-label">@MonthShort[m]</div>
                    </div>
                }
            </div>
            <div class="legend small muted">
                <span><i class="swatch swatch-before"></i>@(isBattery ? "be kaupiklio" : "dabar")</span>
                <span><i class="swatch swatch-after"></i>@(isBattery ? "su kaupikliu" : "su saulės elektrine")</span>
            </div>
        </section>
    }

    <h2 class="section-title">Palyginimas</h2>
    <div class="plan-grid">
        @foreach (var plan in best)
        {
            <PlanCard Plan="plan" IsRec="plan.Id == recommendedId" MaxCost="maxCost" FixedCost="bestFixed?.YearlyCost" />
        }
    </div>
    <p class="muted small mt-2">Juosta rodo, kiek kainuotų pigiais ir brangiais metais; taškas – tikėtina kaina.</p>

    <div class="actions">
        <button type="button" class="btn btn-primary" @onclick="Download">Atsisiųsti .txt</button>
        @if (rec is null)
        {
            <a class="btn btn-outline-secondary" href="assistant">Tęsti apklausą</a>
        }
        <button type="button" class="btn btn-outline-secondary" @onclick="Restart">Pildyti iš naujo</button>
    </div>

    @* ── Techninė dalis: energetikos specialistams ── *@
    <section class="expert">
        <h2 class="expert-title">Išsami informacija <span>energetikos specialistams</span></h2>
        <p class="muted small">
            Galutinė kaina = ESO dalis (laidai) + tiekėjo dalis (energija) + VIAP ir DED + pastovūs mokesčiai@(_profile!.HasSolar ? " ± saulės elektrinė" : "").
            ESO tarifai – nuo @Calculator.Catalog.Eso.ValidFrom.ToString("yyyy-MM-dd"); tiekėjų kainos – DEMO; biržos kainos – tikros LT valandinės (@Calculator.Catalog.NpPeriodLabel).
            Sąvokos – <a href="zodynelis">žodynėlyje</a>.
        </p>

        <div class="kpis mb-3">
            <div class="kpi" title="Σ(kWh × biržos kaina) ÷ Σ kWh – vidutinė biržos kaina, kurią mokėtumėte pagal tai, kada vartojate">
                <div class="kpi-label">Asmeninė svertinė biržos kaina</div>
                <div class="kpi-value">@_profile.PersonalWeightedPrice.ToString("0.000", Lt) €/kWh</div>
                <div class="kpi-note">be PVM · metų vidurkis @_profile.MeanSpotPrice.ToString("0.000", Lt)</div>
            </div>
            <div class="kpi">
                <div class="kpi-label">Iš tinklo per metus</div>
                <div class="kpi-value">@_profile.PurchasedKwh.ToString("#,0", Lt) kWh</div>
                <div class="kpi-note">@_profile.ConsumptionSource</div>
            </div>
            <div class="kpi">
                <div class="kpi-label">Naktis + savaitgaliai</div>
                <div class="kpi-value">@Percent(_profile.TwoZoneNightShare)</div>
                <div class="kpi-note">2 zonų „naktis“</div>
            </div>
            <div class="kpi">
                <div class="kpi-label">Leistinoji galia (LG)</div>
                <div class="kpi-value">@_profile.LgKw.ToString("0.#", Lt) kW</div>
                <div class="kpi-note">@(_profile.LgFromEso ? "pagal ESO" : "prielaida")</div>
            </div>
        </div>

        <section class="panel panel-tight why">
            <h3 class="h6 mb-2">Kodėl toks ESO planas ir zonos</h3>
            <ul class="why-list">
                @foreach (var line in _insights)
                {
                    <li>@line</li>
                }
            </ul>
            @if (_warnings.Count > 0)
            {
                <div class="notice notice-warn mt-2">
                    <strong>Biržos plano rizika:</strong>
                    <ul class="mb-0">
                        @foreach (var w in _warnings)
                        {
                            <li>@w</li>
                        }
                    </ul>
                </div>
            }
        </section>

        @if (_solarReport is { } tech)
        {
            var techBattery = tech.IsBatteryMode;
            PlanType? bestWithSolar = tech.WithSolar.Count > 1 && tech.WithSolar[1].YearlyCost - tech.WithSolar[0].YearlyCost >= 12
                ? tech.WithSolar[0].Type
                : null;
            var solarMax = tech.WithSolar.Concat(tech.Baseline).Max(e => e.WorstCost);

            <section class="panel panel-tight mt-3">
                <h3 class="h6 mb-2">@(techBattery ? "Kaupiklis" : "Saulės elektrinė"): skaičiavimo detalės</h3>

                @if (tech.ExportLimitKw is { } exportLimit)
                {
                    <div class="notice notice-warn mb-3">
                        ⚠️ ESO duomenimis atidavimas į tinklą ribojamas iki @exportLimit.ToString("0.#", Lt) kW – tai įskaičiuota: perteklius virš ribos prarandamas.
                    </div>
                }

                <div class="kpis">
                    @if (tech.Chosen.Capex > 0)
                    {
                        <div class="kpi"><div class="kpi-label">Nauda per 25 m. (NPV)</div><div class="kpi-value">@Eur(tech.Chosen.Npv)</div></div>
                    }
                    @if (tech.Mode == SolarMode.BatteryOnly)
                    {
                        <div class="kpi"><div class="kpi-label">Perkelta per metus</div><div class="kpi-value">@tech.BatteryDeliveredKwh.ToString("#,0", Lt) kWh</div></div>
                    }
                    else
                    {
                        <div class="kpi"><div class="kpi-label">Savarankiškumas</div><div class="kpi-value">@tech.Chosen.SelfSufficiencyPct.ToString("#,0", Lt) %</div></div>
                    }
                    <div class="kpi"><div class="kpi-label">Sutaupoma ESO dalis</div><div class="kpi-value">@Eur(tech.EsoSavedPerYear) / m.</div></div>
                </div>

                <h4 class="solar-sub">Visa mėnesio sąskaita pagal tarifo tipą</h4>
                <p class="muted small">Kiekvienam tipui parinktas pigiausias derinys@(tech.Settlements.Count > 0 ? " ir pasaugojimo būdas" : ""); su kaupikliu – tik dinaminis tarifas.</p>
                <div class="plan-grid">
                    @foreach (var plan in tech.WithSolar)
                    {
                        <PlanCard Plan="plan" IsRec="plan.Type == bestWithSolar" RibbonText="Geriausia" MaxCost="solarMax"
                                  CompareTo="tech.Baseline.FirstOrDefault(b => b.Type == plan.Type)"
                                  CompareLabel="@(techBattery ? "vs be kaupiklio" : "vs be saulės")" />
                    }
                </div>

                @if (tech.Settlements.Count > 0)
                {
                    <h4 class="solar-sub">Energijos pasaugojimo būdas</h4>
                    <table class="plans-table batt-table">
                        <thead>
                            <tr><th>Būdas</th><th>Per metus</th><th>Per mėn.</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var row in tech.Settlements)
                            {
                                <tr class="@(row.Best ? "is-best" : null)">
                                    <td>
                                        @row.Label
                                        @if (row.Best)
                                        {
                                            <span class="pill pill-ok ms-1">pigiausia</span>
                                        }
                                        @if (row.LeftoverKwh > 0)
                                        {
                                            <div class="small muted">banke lieka @row.LeftoverKwh.ToString("#,0", Lt) kWh</div>
                                        }
                                    </td>
                                    <td>@Eur(row.YearlyCost)</td>
                                    <td>@Eur(row.YearlyCost / 12)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <p class="muted small">Su @tech.PlanLabel. ESO būdą galima keisti kartą per 12 mėn., schemą – kartą per kaupimo laikotarpį (2026-04-01 – 2028-03-31); nepanaudotas likutis laikotarpio pabaigoje kompensuojamas (išmokai pinigais GPM taikomas nuo 2 500 €). Planuojama gaminantiems VIAP iki 1 ct/kWh – dydžiai dar nepaskelbti.</p>
                }

                <h4 class="solar-sub">Pagal tarifą (kaupiklis – tik su dinaminiu)</h4>
                <table class="plans-table batt-table">
                    <thead>
                        <tr><th>Planas</th><th>@(techBattery ? "Be kaupiklio" : "Tik elektrinė")</th><th>Su kaupikliu</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var (type, scan) in tech.ByType)
                        {
                            <tr>
                                <td>@Recommendation.PlanTypeLabel(type)</td>
                                <td>@(techBattery ? "—" : $"{scan.BestPvOnly.PvKwp:0.#} kWp · {Payback(scan.BestPvOnly)}")</td>
                                <td>
                                    @if (scan.BestWithBattery is { } wb)
                                    {
                                        <span>@wb.BattKwh.ToString("#,0", Lt) kWh · @Payback(wb)</span>
                                        <span class="pill @(scan.BatteryWorthIt ? "pill-ok" : "pill-danger") ms-1">@(scan.BatteryWorthIt ? "verta" : "neverta")</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <EsoConnectionCard OnChecked="Recalculate" />

                <details class="fold mt-3">
                    <summary>Kiti variantai ir prielaidos</summary>
                    <ul class="answers">
                        @foreach (var o in tech.Scan.All.Take(5))
                        {
                            <li>
                                <div class="a">@o.PvKwp.ToString("0.#", Lt) kWp + @o.BattKwh.ToString("#,0", Lt) kWh</div>
                                <div class="q">investicija @Eur(o.Capex) · atsipirkimas @Payback(o) · NPV @Eur(o.Npv) · savarankiškumas @o.SelfSufficiencyPct.ToString("#,0", Lt) %</div>
                            </li>
                        }
                    </ul>
                    <p class="note">@tech.Assumptions @(tech.LoadFromFile ? "Skaičiuota pagal jūsų ESO valandinius duomenis." : "Vartojimo profilis įvertintas pagal atsakymus.")</p>
                </details>
            </section>
        }

        <div class="two-col">
            <section class="panel panel-tight">
                <h3 class="h6 mb-3">Jūsų profilis</h3>
                <dl class="facts">
                    <dt>Metinis suvartojimas</dt>
                    <dd>@_profile.AnnualKwh.ToString("#,0", Lt) kWh (@_profile.ConsumptionSource)</dd>
                    @if (_profile.HasSolar)
                    {
                        <dt>Paimama iš tinklo</dt>
                        <dd>@_profile.PurchasedKwh.ToString("#,0", Lt) kWh</dd>
                        <dt>Atiduodama į tinklą</dt>
                        <dd>@((_profile.Export?.Sum() ?? 0).ToString("#,0", Lt)) kWh</dd>
                    }
                    <dt>Vartojimas naktį (22–6 val.)</dt>
                    <dd>@Percent(_profile.NightShare)</dd>
                    <dt>Vartojimas vakare (17–22 val.)</dt>
                    <dd>@Percent(_profile.EveningShare)</dd>
                    <dt>Žiemos mėnesiais (lapkritis–vasaris)</dt>
                    <dd>@Percent(_profile.WinterShare) metų suvartojimo</dd>
                    <dt>Galima perkelti</dt>
                    <dd>@Percent(_profile.ShiftPotential)</dd>
                    <dt>Rizikos tolerancija</dt>
                    <dd>@RiskTolerance(_profile.RiskAversion)</dd>
                </dl>
                @foreach (var note in _profile.Notes)
                {
                    <p class="note">ℹ️ @note</p>
                }
            </section>

            <section class="panel panel-tight">
                <details class="fold">
                    <summary>Visi deriniai nuo pigiausio (@_estimates.Count)</summary>
                    <table class="plans-table">
                        <thead>
                            <tr><th>ESO planas + tiekėjo planas</th><th>Per mėn.</th><th>Metams</th><th>Rizika</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var e in _estimates)
                            {
                                <tr class="@(e.Id == recommendedId ? "is-best" : null)">
                                    <td>
                                        <div>@e.PlanName</div>
                                        <div class="small muted">@e.EsoLabel@(e.Settlement is { } st ? $" · {st}" : "")</div>
                                    </td>
                                    <td>@Eur(e.MonthlyCost)</td>
                                    <td>@Eur(e.YearlyCost)</td>
                                    <td>@e.RiskLevel</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <p class="note">Atmesti neleistini deriniai: tiekėjo zonų skaičius turi sutapti su ESO plano zonomis@(_profile.HasSmartMeter ? "" : ", 4 zonos – tik su išmaniuoju skaitikliu"); garantinis tiekimas į rekomendacijas neįtraukiamas.</p>
                </details>
                <hr />
                <details class="fold">
                    <summary>Jūsų atsakymai (@State.AnsweredQuestions().Count)</summary>
                    <ul class="answers">
                        @foreach (var question in State.AnsweredQuestions())
                        {
                            var answer = State.GetAnswer(question.Id);
                            <li>
                                <div class="q">@question.Text</div>
                                <div class="a">
                                    @QuestionnaireState.FormatAnswer(answer)
                                    @if (answer.IsAuto)
                                    {
                                        <span class="pill pill-accent ms-1">iš failo</span>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                </details>
            </section>
        </div>
    </section>
}

@code {
    private static readonly CultureInfo Lt = CultureInfo.GetCultureInfo("lt-LT");

    private bool _loaded;
    private HouseholdProfile? _profile;
    private IReadOnlyList<PlanEstimate> _estimates = Array.Empty<PlanEstimate>();
    private SolarReport? _solarReport;
    private IReadOnlyList<string> _insights = Array.Empty<string>();
    private IReadOnlyList<string> _warnings = Array.Empty<string>();
    private IReadOnlyList<string> _reasons = Array.Empty<string>();

    private static readonly string[] MonthShort = { "Sau", "Vas", "Kov", "Bal", "Geg", "Bir", "Lie", "Rgp", "Rgs", "Spa", "Lap", "Gru" };

    private static readonly string[] MonthNames =
    {
        "Sausis", "Vasaris", "Kovas", "Balandis", "Gegužė", "Birželis",
        "Liepa", "Rugpjūtis", "Rugsėjis", "Spalis", "Lapkritis", "Gruodis"
    };

    protected override async Task OnInitializedAsync()
    {
        await State.LoadAsync();
        Recalculate();
        _loaded = true;
    }

    private static string Eur(double value) => value.ToString("#,0", Lt) + " €";

    private static string Percent(double share) => (share * 100).ToString("#,0", Lt) + " %";

    private void Recalculate()
    {
        _profile = Calculator.BuildProfile(State);
        _estimates = Calculator.Estimate(_profile);
        _insights = Calculator.EsoInsights(_profile);
        _warnings = Calculator.RiskWarnings(_profile);
        var offer = _estimates.FirstOrDefault(e => e.Id == State.Recommendation?.PlanId) ?? PlanCalculator.Recommended(_estimates);
        _reasons = Calculator.SimpleReasons(_profile, offer);
        _solarReport = Solar.Evaluate(State);
    }

    private static string Payback(SolarOption o) =>
        o.PaybackYears is { } y ? $"atsiperka per {y.ToString("0.#", Lt)} m." : "neatsiperka";

    private static string Css(double value) => value.ToString("0.#", CultureInfo.InvariantCulture);

    private static string RiskTolerance(double aversion) => aversion switch
    {
        >= 0.7 => "Žema – svarbu stabilumas",
        >= 0.4 => "Vidutinė",
        _ => "Aukšta – galite rizikuoti"
    };

    private async Task Download()
    {
        await State.SubmitAsync();
        await JS.InvokeVoidAsync("elektra.downloadText", $"elektros-planas-{DateTime.Now:yyyyMMdd-HHmm}.txt", State.BuildTextReport());
    }

    private async Task Restart()
    {
        await State.ResetAsync();
        Nav.NavigateTo("/assistant", forceLoad: true);
    }
}
