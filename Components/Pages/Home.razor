@page "/"

<PageTitle>Elektros planas</PageTitle>

<div class="py-4">
    <h1 class="display-6 fw-bold">Elektros planas</h1>
    <p class="lead">
        Padėsime vilniečiams išsirinkti tinkamiausią elektros planą pagal jų vartojimo įpročius.
    </p>

    <div class="d-flex flex-wrap gap-2 mt-2">
        <a class="btn btn-primary btn-lg" href="/upload">Įkelti suvartojimo failą</a>
        <a class="btn btn-outline-primary btn-lg" href="/survey">Pradėti apklausą</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5 card-title">1. Duomenys</h2>
                <p class="card-text mb-0">
                    Įkelkite suvartojimo failą – dalį klausimų atsakysime automatiškai,
                    arba atsakykite rankiniu būdu.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5 card-title">2. Planų palyginimas</h2>
                <p class="card-text mb-0">Palyginkite fiksuotą ir lankstų tarifą.</p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5 card-title">3. Rizika ir nauda</h2>
                <p class="card-text mb-0">Įvertinkite galimą riziką ir naudą.</p>
            </div>
        </div>
    </div>
</div>
