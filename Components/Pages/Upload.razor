@page "/upload"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Globalization
@inject QuestionnaireState State
@inject ConsumptionAnalyzer Analyzer

<PageTitle>Įkelti duomenis</PageTitle>

<h1 class="h4">Įkelkite elektros suvartojimo failą</h1>
<p class="text-muted">
    Priimami <code>.csv</code> ir <code>.txt</code> failai su data/laiku ir suvartojimu (kWh).
    Įkėlus failą, su vartojimu susiję klausimai bus atsakyti automatiškai – juos galėsite pataisyti.
</p>

<div class="mb-3">
    <InputFile OnChange="OnFileSelected" accept=".csv,.txt" class="form-control" />
</div>

@if (_message is not null)
{
    <div class="alert @(_success ? "alert-success" : "alert-warning")">@_message</div>
}

<div class="d-flex flex-wrap gap-2 mt-3">
    <a class="btn btn-primary" href="/survey">@(_success ? "Tęsti apklausą →" : "Pradėti apklausą →")</a>
    <a class="btn btn-outline-secondary" href="/results">Rezultatai</a>
</div>

@code {
    private static readonly CultureInfo Lt = CultureInfo.GetCultureInfo("lt-LT");

    private bool _success;
    private string? _message;

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
        {
            return;
        }

        using var stream = file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
        using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);
        buffer.Position = 0;

        var analysis = Analyzer.Analyze(buffer, file.Name);
        State.Analysis = analysis;

        if (analysis.Success)
        {
            // The "model" answers the consumption questions so the user does not have to.
            if (analysis.MonthlyAverageKwh is { } average)
            {
                State.SetAutoAnswer(3, MonthlyRangeLabel(average));
            }

            if (analysis.PeakPeriodLabel is not null)
            {
                State.SetAutoAnswer(15, analysis.PeakPeriodLabel);
            }

            await State.SaveAsync();

            _success = true;
            _message = $"Nuskaityta {analysis.Readings} įrašų ({analysis.Months} mėn.). " +
                       $"Vidutiniškai {analysis.MonthlyAverageKwh!.Value.ToString("0.0", Lt)} kWh/mėn. " +
                       "Su vartojimu susiję klausimai užpildyti automatiškai.";
        }
        else
        {
            _success = false;
            _message = analysis.Error;
            await State.SaveAsync();
        }
    }

    private static string MonthlyRangeLabel(double kwh) => kwh switch
    {
        < 150 => "Iki 150 kWh",
        <= 300 => "150–300 kWh",
        _ => "Virš 300 kWh"
    };
}
