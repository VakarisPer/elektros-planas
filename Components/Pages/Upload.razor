@page "/upload"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Globalization
@inject QuestionnaireState State
@inject ConsumptionAnalyzer Analyzer
@inject EsoConnectionService Eso

<PageTitle>Duomenys · Elektros planas</PageTitle>

<div class="page-head">
    <div class="eyebrow">1 žingsnis · neprivaloma, bet labai padeda</div>
    <h1>Įkelkite elektros suvartojimo duomenis</h1>
    <p>
        Atsisiųskite valandinius duomenis iš <strong>mano.eso.lt</strong> (CSV) ir įkelkite čia. Apskaičiuosime suvartojimą
        kiekvieną valandą, o pagal objekto numerį patys patikrinsime ESO prijungimo galimybes (galimą apkrovą).
    </p>
</div>

<label class="dropzone @(_loading ? "is-loading" : null)">
    <InputFile OnChange="OnFileSelected" accept=".csv,.txt" class="dropzone-input" />
    <span class="dropzone-icon" aria-hidden="true">📄</span>
    <span class="dropzone-title">@(_loading ? "Analizuojama…" : "Pasirinkite arba nutempkite failą")</span>
    <span class="muted small">.csv arba .txt su data/laiku ir kWh, iki 20 MB</span>
</label>

@if (_message is not null)
{
    <div class="notice @(_success ? "notice-ok" : "notice-warn") mt-3">@_message</div>
}

@if (State.Analysis is { Success: true } a)
{
    <div class="stats">
        <div class="stat panel panel-tight">
            <div class="stat-label">@(a.ExportedMonthlyKwh is null ? "Vidutiniškai per mėn." : "Perkama iš tinklo per mėn.")</div>
            <div class="stat-value">@(a.MonthlyAverageKwh?.ToString("0", Lt) ?? "—") <span>kWh</span></div>
        </div>
        <div class="stat panel panel-tight">
            <div class="stat-label">Naktinis vartojimas</div>
            <div class="stat-value">@(a.NightShare is { } n ? (n * 100).ToString("0", Lt) : "—") <span>%</span></div>
        </div>
        @if (a.ExportedMonthlyKwh is { } exported)
        {
            <div class="stat panel panel-tight">
                <div class="stat-label">Atiduodama į tinklą per mėn.</div>
                <div class="stat-value">@exported.ToString("0", Lt) <span>kWh</span></div>
            </div>
        }
        <div class="stat panel panel-tight">
            <div class="stat-label">Laikotarpis</div>
            <div class="stat-value">@a.Months <span>mėn.</span></div>
        </div>
    </div>
}

<EsoConnectionCard ObjectNumber="@State.Analysis?.ObjectNumber" />

<div class="d-flex flex-wrap gap-2 mt-4">
    <a class="btn btn-primary btn-lg" href="assistant">@(_success ? "Tęsti su asistentu →" : "Eiti į asistentą →")</a>
</div>

<p class="muted small mt-3 mb-0">Failas apdorojamas serveryje tik analizei ir niekur nesiunčiamas; į eso.lt siunčiamas tik objekto numeris.</p>

@code {
    private static readonly CultureInfo Lt = CultureInfo.GetCultureInfo("lt-LT");

    private bool _success;
    private bool _loading;
    private string? _message;

    protected override async Task OnInitializedAsync() => await State.LoadAsync();

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
        {
            return;
        }

        _loading = true;
        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            buffer.Position = 0;

            var analysis = Analyzer.Analyze(buffer, file.Name);
            State.Analysis = analysis;

            if (analysis.Success)
            {
                // With a file the consumption question is answered automatically.
                if (analysis.MonthlyAverageKwh is { } average)
                {
                    State.SetAutoAnswer(3, average switch
                    {
                        < 150 => Questionnaire.MonthlyLow,
                        <= 300 => Questionnaire.MonthlyMid,
                        <= 600 => Questionnaire.MonthlyHigh,
                        _ => Questionnaire.MonthlyVeryHigh
                    });
                }

                // Energy given back to the grid means an own solar plant.
                if (analysis.ExportedMonthlyKwh is > 1)
                {
                    State.SetAutoAnswer(8, Questionnaire.OwnSolar);
                }

                // Hourly data can only come from a smart meter.
                if (analysis.NightShare is not null)
                {
                    State.SetAutoAnswer(20, Questionnaire.SmartMeterYes);
                }

                // The scheme: with an ESO file the program checks the grid capacity itself.
                if (analysis.ObjectNumber is { } objectNumber)
                {
                    State.ApplyEsoConnection(await Eso.CheckAsync(objectNumber));
                }

                _success = true;
                _message = $"Nuskaityta {analysis.Readings} įrašų ({analysis.Months} mėn.). " +
                           "Suvartojimas ir skaitiklio tipas užpildyti automatiškai" +
                           (State.EsoConnection is { Success: true } ? ", ESO prijungimo galimybės patikrintos." : ".");
            }
            else
            {
                _success = false;
                _message = analysis.Error;
            }

            await State.SaveAsync();
        }
        finally
        {
            _loading = false;
        }
    }

}
