@page "/survey"
@page "/survey/{QuestionId:int}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject QuestionnaireState State
@inject NavigationManager Nav
@inject PlanCalculator Calculator
@inject SolarAdvisor Solar

<PageTitle>Klasikinė anketa · Elektros planas</PageTitle>

@if (_question is null)
{
    <p class="muted">Kraunama…</p>
}
else
{
    <ProgressBar Current="State.PositionOf(_question.Id)" Total="State.VisibleCount" />

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3 mb-2">
        <div class="eyebrow">@_question.Section</div>
        <a class="small" href="assistant">Pereiti prie AI asistento →</a>
    </div>

    @if (State.PositionOf(_question.Id) == 1)
    {
        @if (State.Analysis is not { Success: true })
        {
            <div class="notice mb-3">📄 1 žingsnis – <a href="upload">įkelkite ESO duomenų failą</a>: suvartojimą ir skaitiklio tipą užpildysime patys, o ESO prijungimo galimybes patikrinsime automatiškai.</div>
        }
        <div class="notice mb-3">💬 @Questionnaire.StartNotice</div>
    }

    @if (Answer.IsAuto)
    {
        <span class="pill pill-accent mb-2">Atsakyta automatiškai iš įkelto failo – galite pataisyti</span>
    }

    <QuestionCard Question="_question" Answer="Answer" OnAnswerChanged="StateHasChanged" />

    <div class="d-flex justify-content-between mt-3">
        <button type="button"
                class="btn btn-outline-secondary"
                disabled="@(PreviousId is null)"
                @onclick="GoBack">
            ← Atgal
        </button>

        <button type="button"
                class="btn btn-primary"
                disabled="@(!State.IsQuestionAnswered(_question))"
                @onclick="GoNext">
            @NextLabel
        </button>
    </div>

    @if (!State.IsQuestionAnswered(_question))
    {
        <p class="muted small mt-2 mb-0">Pasirinkite atsakymą, kad galėtumėte tęsti.</p>
    }
}

@code {
    [Parameter]
    public int QuestionId { get; set; }

    private Question? _question;

    private Answer Answer => State.GetAnswer(_question!.Id);

    private int? PreviousId => _question is null ? null : State.PreviousVisibleId(_question.Id);

    private int? NextId => _question is null ? null : State.NextVisibleId(_question.Id);

    private string NextLabel => NextId is null ? "Baigti" : "Toliau →";

    protected override async Task OnParametersSetAsync()
    {
        await State.LoadAsync();

        if (QuestionId <= 0)
        {
            var resume = State.FirstVisibleUnansweredId() ?? Questionnaire.FirstQuestionId;
            Nav.NavigateTo($"/survey/{resume}");
            return;
        }

        var question = Questionnaire.GetQuestion(QuestionId);
        if (question is null)
        {
            Nav.NavigateTo($"/survey/{Questionnaire.FirstQuestionId}", replace: true);
            return;
        }

        // The tree may have changed while navigating back - skip hidden questions.
        if (!State.IsVisible(question))
        {
            Nav.NavigateTo($"/survey/{State.NearestVisibleId(QuestionId)}", replace: true);
            return;
        }

        _question = question;
        State.CurrentQuestionId = QuestionId;
        await State.SaveAsync();
    }

    private void GoBack()
    {
        if (PreviousId is { } id)
        {
            Nav.NavigateTo($"/survey/{id}");
        }
    }

    private async Task GoNext()
    {
        if (_question is null)
        {
            return;
        }

        if (NextId is { } id)
        {
            Nav.NavigateTo($"/survey/{id}");
            return;
        }

        // Last visible question - make sure nothing was left unanswered out of order.
        if (!State.IsComplete)
        {
            var missing = State.FirstVisibleUnansweredId();
            if (missing is { } first && first != _question.Id)
            {
                Nav.NavigateTo($"/survey/{first}");
                return;
            }
        }

        var profile = Calculator.BuildProfile(State);
        var recommendation = Calculator.RuleBasedRecommendation(profile, Calculator.Estimate(profile));
        if (Solar.Evaluate(State) is { } solar)
        {
            recommendation.SummaryMarkdown = recommendation.SummaryMarkdown.TrimEnd() + Environment.NewLine + Environment.NewLine + Solar.Paragraph(solar);
        }

        State.Recommendation = recommendation;
        await State.SubmitAsync();
        Nav.NavigateTo("/results");
    }
}
