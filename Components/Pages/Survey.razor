@page "/survey"
@page "/survey/{QuestionId:int}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject QuestionnaireState State
@inject NavigationManager Nav

<PageTitle>Apklausa</PageTitle>

@if (_question is null)
{
    <p class="text-muted">Kraunama…</p>
}
else
{
    <ProgressBar Current="State.PositionOf(_question.Id)" Total="State.VisibleCount" />

    <h1 class="h4 mt-3">@_question.Section</h1>

    @if (Answer.IsAuto)
    {
        <span class="badge text-bg-info mb-2">Automatinis atsakymas (iš įkelto failo) – galite pataisyti</span>
    }

    <QuestionCard Question="_question" Answer="Answer" OnAnswerChanged="StateHasChanged" />

    <div class="d-flex justify-content-between mt-3">
        <button type="button"
                class="btn btn-outline-secondary"
                disabled="@(PreviousId is null)"
                @onclick="GoBack">
            ← Atgal
        </button>

        <button type="button"
                class="btn btn-primary"
                disabled="@(!State.IsQuestionAnswered(_question))"
                @onclick="GoNext">
            @NextLabel
        </button>
    </div>

    @if (!State.IsQuestionAnswered(_question))
    {
        <p class="text-muted small mt-2 mb-0">Pasirinkite atsakymą, kad galėtumėte tęsti.</p>
    }
}

@code {
    [Parameter]
    public int QuestionId { get; set; }

    private Question? _question;

    private Answer Answer => State.GetAnswer(_question!.Id);

    private int? PreviousId => _question is null ? null : State.PreviousVisibleId(_question.Id);

    private int? NextId => _question is null ? null : State.NextVisibleId(_question.Id);

    private string NextLabel => NextId is null ? "Baigti" : "Toliau →";

    protected override async Task OnParametersSetAsync()
    {
        await State.LoadAsync();

        if (QuestionId <= 0)
        {
            var resume = State.FirstVisibleUnansweredId() ?? Questionnaire.FirstQuestionId;
            Nav.NavigateTo($"/survey/{resume}");
            return;
        }

        var question = Questionnaire.GetQuestion(QuestionId);
        if (question is null)
        {
            Nav.NavigateTo($"/survey/{Questionnaire.FirstQuestionId}", replace: true);
            return;
        }

        // The tree may have changed while navigating back - skip hidden questions.
        if (!State.IsVisible(question))
        {
            Nav.NavigateTo($"/survey/{State.NearestVisibleId(QuestionId)}", replace: true);
            return;
        }

        _question = question;
        State.CurrentQuestionId = QuestionId;
        await State.SaveAsync();
    }

    private void GoBack()
    {
        if (PreviousId is { } id)
        {
            Nav.NavigateTo($"/survey/{id}");
        }
    }

    private async Task GoNext()
    {
        if (_question is null)
        {
            return;
        }

        if (NextId is { } id)
        {
            Nav.NavigateTo($"/survey/{id}");
            return;
        }

        // Last visible question - make sure nothing was left unanswered out of order.
        if (!State.IsComplete)
        {
            var missing = State.FirstVisibleUnansweredId();
            if (missing is { } first && first != _question.Id)
            {
                Nav.NavigateTo($"/survey/{first}");
                return;
            }
        }

        await State.SubmitAsync();
        Nav.NavigateTo("/results");
    }
}
