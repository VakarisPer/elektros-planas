@inject QuestionnaireState State

<div class="panel mb-3">
    <h2 class="h5 mb-1">@Question.Text</h2>

    @if (Question.IsMultiSelect)
    {
        <p class="muted small mb-0">Galima pasirinkti kelis variantus.</p>
    }

    <div class="option-list mt-3">
        @for (var i = 0; i < Question.Options.Count; i++)
        {
            var option = Question.Options[i];
            var inputId = $"q-{Question.Id}-{i}";
            var isChecked = Answer.SelectedOptions.Contains(option);

            <label class="option-card @(isChecked ? "selected" : null)" for="@inputId">
                @if (Question.IsMultiSelect)
                {
                    <input type="checkbox" name="q-@Question.Id" id="@inputId" checked="@isChecked"
                           @onchange="e => OnMultiOptionChanged(option, (bool)e.Value!)" />
                }
                else
                {
                    <input type="radio" name="q-@Question.Id" id="@inputId" checked="@isChecked"
                           @onchange="() => OnSingleOptionChanged(option)" />
                }
                <span>@option</span>
            </label>
        }

        @if (Question.AllowCustom)
        {
            var customId = $"q-{Question.Id}-custom";
            var customSelected = Answer.SelectedOptions.Contains(Question.CustomOption);

            <label class="option-card @(customSelected ? "selected" : null)" for="@customId">
                @if (Question.IsMultiSelect)
                {
                    <input type="checkbox" name="q-@Question.Id" id="@customId" checked="@customSelected"
                           @onchange="e => OnMultiOptionChanged(Question.CustomOption, (bool)e.Value!)" />
                }
                else
                {
                    <input type="radio" name="q-@Question.Id" id="@customId" checked="@customSelected"
                           @onchange="() => OnSingleOptionChanged(Question.CustomOption)" />
                }
                <span>Kita (įrašyti savo)</span>
            </label>

            @if (customSelected)
            {
                <input type="text" class="form-control" value="@Answer.CustomText"
                       placeholder="Įrašykite savo variantą" @onchange="OnCustomTextChanged" />
            }
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Question Question { get; set; } = default!;

    [Parameter, EditorRequired]
    public Answer Answer { get; set; } = default!;

    [Parameter]
    public EventCallback OnAnswerChanged { get; set; }

    private async Task OnSingleOptionChanged(string option)
    {
        State.SetSingle(Question.Id, option);
        await SaveAndNotify();
    }

    private async Task OnMultiOptionChanged(string option, bool isChecked)
    {
        State.ToggleMulti(Question.Id, option, isChecked, Question.ExclusiveOption);
        await SaveAndNotify();
    }

    private async Task OnCustomTextChanged(ChangeEventArgs e)
    {
        State.SetCustomText(Question.Id, e.Value?.ToString());
        await SaveAndNotify();
    }

    private async Task SaveAndNotify()
    {
        await State.SaveAsync();
        await OnAnswerChanged.InvokeAsync();
    }
}
