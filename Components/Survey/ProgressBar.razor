<div class="mb-2">
    <div class="small text-muted">Klausimas @Current iš @Total</div>
    <div class="progress mt-1"
         role="progressbar"
         aria-label="Apklausos progresas"
         aria-valuenow="@Percent"
         aria-valuemin="0"
         aria-valuemax="100"
         style="height: 8px;">
        <div class="progress-bar" style="width: @Percent%"></div>
    </div>
</div>

@code {
    [Parameter]
    public int Current { get; set; }

    [Parameter]
    public int Total { get; set; }

    private int Percent => Total <= 0 ? 0 : (int)Math.Round(Current * 100.0 / Total);
}
