<div class="mb-2">
    <div class="d-flex justify-content-between small muted mb-1">
        <span>Klausimas @Current iš @Total</span>
        <span>@Percent %</span>
    </div>
    <div class="progress-track" role="progressbar" aria-label="Apklausos progresas"
         aria-valuenow="@Percent" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-fill" style="width: @Percent%"></div>
    </div>
</div>

@code {
    [Parameter]
    public int Current { get; set; }

    [Parameter]
    public int Total { get; set; }

    private int Percent => Total <= 0 ? 0 : (int)Math.Round(Current * 100.0 / Total);
}
